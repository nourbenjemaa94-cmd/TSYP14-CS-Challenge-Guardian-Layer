# Compose project variables (interpolation only, no secrets).
# Copy to .env next to docker-compose.yml. This file is distinct from
# guardian/.env, which holds the HMAC keys and is passed to containers via env_file.

# Port Guardian listens on inside the container and publishes on the host.
GUARDIAN_PORT=8000
# City Brain ingest endpoint as seen from the Guardian container.
CITY_BRAIN_URL=http://brain-http-mock:8002/api/v1/brain/ingest
# Ollama HTTP API as seen from the Guardian container.
GUARDIAN_LLM_URL=http://host.docker.internal:11434
