# Placeholders only. Replace each key with the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A copied file still fails startup until the placeholders are replaced,
# because each key must be at least 32 characters.
# Share the real values with the partner that needs them over a private channel.

GUARDIAN_HMAC_KEY_TWIN=change-me
GUARDIAN_HMAC_KEY_BRAIN=change-me
GUARDIAN_HMAC_KEY_GUARDIAN=change-me

GUARDIAN_MAX_MESSAGE_BYTES=65536
GUARDIAN_SCHEMA_MAJOR=1
GUARDIAN_ALLOWED_TYPES=
GUARDIAN_MAX_AGE_SECONDS=30
GUARDIAN_MAX_FUTURE_SKEW_SECONDS=5
GUARDIAN_RATE_PER_SOURCE=5
GUARDIAN_RATE_BURST=20
GUARDIAN_FLOOD_THRESHOLD=10
# Timeline WebSocket exposure: disabled, local (loopback), or demo (explicit jury demo).
GUARDIAN_TIMELINE_MODE=local

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional TLS files mounted read-only at /run/secrets/certs in Compose.
# MQTT_CA_CERT=/run/secrets/certs/ca.pem
# MQTT_CLIENT_CERT=/run/secrets/certs/client.pem
# MQTT_CLIENT_KEY=/run/secrets/certs/client.key

# Optional overrides of config.example.yaml. Leave unset to use the file.
# GUARDIAN_CONFIG=config.example.yaml
# GUARDIAN_URL=http://127.0.0.1:8000/api/v1/telemetry
# GUARDIAN_BASE_URL=http://127.0.0.1:8000  # legacy client fallback
# GUARDIAN_HTTP_HOST=0.0.0.0
# GUARDIAN_HTTP_PORT=8000

# Contract adapter (handoff section 9).
# LLM provider used by the profile proposer.
GUARDIAN_LLM_PROVIDER=ollama
# Base URL of the Ollama HTTP API on this machine.
GUARDIAN_LLM_URL=http://localhost:11434
# Chat model. Empty until the runtime check records the model that loads.
GUARDIAN_LLM_MODEL=
# Embedding model for schema similarity.
GUARDIAN_EMBED_MODEL=nomic-embed-text
# Seconds to wait for one Ollama request.
GUARDIAN_LLM_TIMEOUT_SECONDS=60
# Context length sent to Ollama as num_ctx.
GUARDIAN_LLM_NUM_CTX=2048
# GPU layers. -1 keeps Ollama's default; 0 forces CPU only.
GUARDIAN_LLM_NUM_GPU=-1
# Directory where learned mapping profiles are stored.
GUARDIAN_PROFILE_DIR=data/profiles
# Authenticated Twin identity associated with the shipped profiles.
# Configure a distinct identity and register its profiles before activation.
GUARDIAN_TWIN_IDENTITY=twin:S01
# Messages retained per unknown schema while onboarding runs.
GUARDIAN_ONBOARDING_BUFFER=20
# Seconds before an onboarding attempt is abandoned.
GUARDIAN_ONBOARDING_TIMEOUT_SECONDS=120
# Clean maps required before a probation profile is promoted.
GUARDIAN_PROBATION_MESSAGES=20
