# Placeholders only. Replace each key with the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
# A copied file still fails startup until the placeholders are replaced,
# because each key must be at least 32 characters.
# Share the real values with the partner that needs them over a private channel.

GUARDIAN_HMAC_KEY_TWIN=change-me
GUARDIAN_HMAC_KEY_BRAIN=change-me
GUARDIAN_HMAC_KEY_GUARDIAN=change-me

GUARDIAN_MAX_MESSAGE_BYTES=65536
GUARDIAN_SCHEMA_MAJOR=1
GUARDIAN_ALLOWED_TYPES=
GUARDIAN_MAX_AGE_SECONDS=30
GUARDIAN_MAX_FUTURE_SKEW_SECONDS=5
GUARDIAN_RATE_PER_SOURCE=5
GUARDIAN_RATE_BURST=20
GUARDIAN_FLOOD_THRESHOLD=10

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional overrides of config.example.yaml. Leave unset to use the file.
# GUARDIAN_CONFIG=config.example.yaml
# GUARDIAN_BASE_URL=http://127.0.0.1:8000
# GUARDIAN_HTTP_HOST=0.0.0.0
# GUARDIAN_HTTP_PORT=8000
